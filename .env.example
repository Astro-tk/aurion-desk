# Aurion Desk environment variables.
# Real values live ONLY in Vercel (Project > Settings > Environment Variables) and in your
# password manager. For local runs, copy this file to .env.local (git ignores it). Never commit secrets.

# ---- App -----------------------------------------------------------------------
# The public address of Desk. Used in email links.
APP_URL=https://desk.aurioncreative.com
# "true" only on a demo database (seeded with fictional data). The database must agree, or Desk refuses to start.
DEMO=false

# ---- Supabase (Project Settings > API, and > Database) --------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# The "anon" / publishable key. Server-side only in Desk (no NEXT_PUBLIC_ copy exists), RLS still applies.
SUPABASE_ANON_KEY=
# The "service_role" / secret key. Bypasses RLS. Server only: ingest, cron, scripts. Treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for migrations and seed scripts only (Connect > Session pooler). Not needed in Vercel.
DATABASE_URL=

# ---- Who may sign in ----------------------------------------------------------------
# Comma-separated emails allowed to sign in. Anyone else is refused before Supabase is even asked.
OWNER_EMAILS=thato@aurioncreative.com

# ---- Secrets you generate (run: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
# Signs Desk's own session clock cookie (7-day / 12-hour limits). At least 32 characters.
SESSION_SECRET=
# Keyed hashing for the suppression list, login throttling and rate limits. At least 32 characters. Never change it once live.
HASH_PEPPER=
# Shared with aurion-assistant: it signs chatbot leads with this. At least 32 characters. Same value in both projects.
INGEST_SIGNING_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/*. At least 16 characters.
CRON_SECRET=

# ---- Website form ingest ------------------------------------------------------------
# Sites allowed to post to /api/ingest/form (comma-separated, exact origins).
INGEST_ALLOWED_ORIGINS=https://aurioncreative.com,https://www.aurioncreative.com

# ---- Email (Resend: resend.com > API Keys) --------------------------------------------
# API key with "Sending access". The aurioncreative.com domain is already verified for aurion-assistant.
RESEND_API_KEY=
# Sender shown on alerts and the digest. Must be on the verified domain.
MAIL_FROM=Aurion Desk <desk@aurioncreative.com>
# Where alerts and the digest go. Optional: defaults to OWNER_EMAILS.
ALERT_EMAIL_TO=

# ---- AI (console.anthropic.com > API keys). Optional: without it, accepting still works, with no AI draft.
ANTHROPIC_API_KEY=
# Model for the lead summary on accept.
AI_MODEL=claude-haiku-5-5

# ---- WhatsApp alert (optional). Same values as aurion-assistant; leave blank to skip WhatsApp cleanly.
# Permanent System User token with whatsapp_business_messaging (aurion-assistant: WHATSAPP_TOKEN).
WHATSAPP_TOKEN=
# Phone number ID from WhatsApp > API Setup (aurion-assistant: WHATSAPP_PHONE_NUMBER_ID).
WHATSAPP_PHONE_NUMBER_ID=
# Your own number, digits only, e.g. 27821234567 (aurion-assistant: ALERT_WHATSAPP_NUMBER).
WHATSAPP_ALERT_NUMBER=
# Approved template with three body values: who, need, score (aurion-assistant: ALERT_TEMPLATE_NAME).
WHATSAPP_ALERT_TEMPLATE=new_lead_alert
# Template language code (aurion-assistant: ALERT_TEMPLATE_LANGUAGE).
WHATSAPP_TEMPLATE_LANGUAGE=en
# Meta Graph API version.
WHATSAPP_GRAPH_VERSION=v23.0
